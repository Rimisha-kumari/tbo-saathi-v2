# ═══════════════════════════════════════════════════════════════════════════
#  TBO Saathi – environment configuration
# ═══════════════════════════════════════════════════════════════════════════
#  EVERY key below is OPTIONAL. Copy this file to .env.local and fill in only
#  what you have. Empty values (or placeholders such as "your-key-here") are
#  treated as "not configured".
#
#  With nothing set, Saathi still runs every feature:
#    • Chat   → built-in Smart Demo Agent (multilingual, same travel tools)
#    • Voice  → browser Web Speech API (speechSynthesis + SpeechRecognition)
#
#  Fallback order (automatic, per request):
#    Chat : Anthropic → OpenAI → Smart Demo Agent  (any LLM error → demo agent)
#    TTS  : Sarvam → Bhashini → OpenAI → browser speechSynthesis
#    STT  : browser SpeechRecognition first; Sarvam → OpenAI only when the
#           browser has no recogniser (e.g. Firefox/Safari)
#  Keys are read on the server only and never sent to the browser.
# ═══════════════════════════════════════════════════════════════════════════

# ── Chat brain: Anthropic Claude (preferred when set) ───────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# ── Chat brain: OpenAI (used if no Anthropic key) + optional voice ───────────
OPENAI_API_KEY=
# Optional overrides (defaults shown)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1

# ── Indian voices: Sarvam AI (TTS "bulbul", STT "saarika") ────────────────────
# Covers en-IN, hi-IN, ta-IN, te-IN, bn-IN. https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_STT_MODEL=saarika:v2.5

# ── Indian voices: Bhashini / ULCA (TTS) ──────────────────────────────────────
# Option A – automatic discovery: set your ULCA user id + API key
#            (from https://bhashini.gov.in/ulca → profile → API key)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Optional discovery overrides
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# Option B – direct inference endpoint (all three required)
BHASHINI_INFERENCE_URL=
BHASHINI_INFERENCE_KEY=
BHASHINI_TTS_SERVICE_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Timeout for each external provider call before falling back (ms)
PROVIDER_TIMEOUT_MS=25000
