# ─── TBO Saathi environment ───────────────────────────────────────────────
# Every key is OPTIONAL. With nothing set, Saathi runs the built-in Smart Demo
# Agent + browser speech (SpeechRecognition / speechSynthesis), so every
# feature works out of the box. Copy to .env.local and fill what you have.

# LLM providers (first one found wins: Anthropic → OpenAI → Smart Demo Agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Indian voice providers (cloud TTS/STT; browser speech is used otherwise)
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=anushka

# Bhashini (ULCA) pipeline – used for TTS when all three are set
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_INFERENCE_KEY=
BHASHINI_TTS_SERVICE_ID=
